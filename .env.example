# =================================================================
#   Observability Platform -- environment template
#  Copy to `.env` (scripts/setup do this) and replace every "change-me".
#  Generate the three crypto secrets with: scripts/gen-secrets.ps1 (or .sh)
# =================================================================

# -- LangFuse core ------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-32+chars
SALT=change-me-salt
ENCRYPTION_KEY=change-me-64-hex-chars   # openssl rand -hex 32  (REQUIRED in v3)

# -- LangFuse headless bootstrap (creates org/project/keys on first boot) --
# Lets agents trace on Day 2 without clicking through the UI first.
LANGFUSE_INIT_ORG_ID=platform
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=agents
LANGFUSE_INIT_PROJECT_NAME=Agent Platform
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-local
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-local
LANGFUSE_INIT_USER_EMAIL=furqan@example.com
LANGFUSE_INIT_USER_NAME=Furqan
LANGFUSE_INIT_USER_PASSWORD=change-me

# -- PostgreSQL (transactional) -----------------------------------
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=langfuse
POSTGRES_DB=langfuse
DATABASE_URL=postgresql://langfuse:langfuse@postgres:5432/langfuse

# -- ClickHouse (trace storage, v3) -------------------------------
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000

# -- Redis --------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# -- S3 / MinIO (event + media blob storage, v3) ------------------
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=miniosecret
LANGFUSE_S3_EVENT_UPLOAD_REGION=us-east-1
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true

# -- OTel Collector -> LangFuse OTLP auth -------------------------
# base64("<PUBLIC_KEY>:<SECRET_KEY>") -- must match the INIT keys above.
# Generate: scripts/gen-secrets.ps1 prints this from the keys, or:
#   echo -n "pk-lf-local:sk-lf-local" | base64
LANGFUSE_OTEL_AUTH=cGstbGYtdGVjaGxvZml4LWxvY2FsOnNrLWxmLXRlY2hsb2dpeC1sb2NhbA==

# -- Grafana ------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=platform

# =================================================================
#  Agent-side vars (set these on every AGENT host, not the platform).
#  Listed here for reference; agents read them from their own env.
# =================================================================
# LANGFUSE_PUBLIC_KEY=pk-lf-local
# LANGFUSE_SECRET_KEY=sk-lf-local
# LANGFUSE_HOST=http://localhost:3000
# DEPLOY_ENV=local
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
