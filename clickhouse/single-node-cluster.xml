<!-- ClickHouse single-node cluster config for LangFuse v3.
     LangFuse v3 runs migrations with ReplicatedMergeTree ON CLUSTER default.
     This requires:
       1. A cluster named "default" defined in remote_servers
       2. Zookeeper / ClickHouse Keeper available for ReplicatedMergeTree coordination
     This file enables the built-in ClickHouse Keeper (no external Zookeeper needed)
     and defines a minimal single-shard / single-replica cluster. -->

<clickhouse>
    <!-- ── Built-in ClickHouse Keeper (replaces Zookeeper for single-node) ── -->
    <keeper_server>
        <tcp_port>9181</tcp_port>
        <server_id>1</server_id>
        <log_storage_path>/var/lib/clickhouse/coordination/log</log_storage_path>
        <snapshot_storage_path>/var/lib/clickhouse/coordination/snapshots</snapshot_storage_path>
        <coordination_settings>
            <operation_timeout_ms>10000</operation_timeout_ms>
            <session_timeout_ms>30000</session_timeout_ms>
            <raft_logs_level>warning</raft_logs_level>
        </coordination_settings>
        <raft_configuration>
            <server>
                <id>1</id>
                <hostname>localhost</hostname>
                <port>9444</port>
            </server>
        </raft_configuration>
    </keeper_server>

    <!-- Point ClickHouse itself at the built-in Keeper -->
    <zookeeper>
        <node>
            <host>localhost</host>
            <port>9181</port>
        </node>
    </zookeeper>

    <!-- Define the "default" cluster LangFuse migrations target -->
    <remote_servers>
        <default>
            <shard>
                <replica>
                    <host>localhost</host>
                    <port>9000</port>
                </replica>
            </shard>
        </default>
    </remote_servers>

    <!-- Macros used by ReplicatedMergeTree paths -->
    <macros>
        <shard>01</shard>
        <replica>01</replica>
    </macros>
</clickhouse>
