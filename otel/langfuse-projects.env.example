# Per-project Langfuse OTLP credentials for the OTel Collector.
# Copy to otel/langfuse-projects.env (gitignored) and fill in one line per
# NON-default project listed in otel/projects.yaml. The default project keeps
# using LANGFUSE_OTEL_AUTH from the root .env.
#
# Value = base64("<public_key>:<secret_key>") of that project's API keys
# (Langfuse UI → Project → Settings → API Keys):
#   echo -n "pk-lf-...:sk-lf-..." | base64
#   [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("pk-lf-...:sk-lf-..."))
#
# Exact names required: python scripts/gen-collector-config.py --list-env
#
# LANGFUSE_OTEL_AUTH_EKA=cGstbGYtLi4uOnNrLWxmLS4uLg==
